      "source": [
        "العمليات = []\n",
        "\n",
        "def أضف_عملية(المبلغ, النوع, التصنيف):\n",
        "    العمليات.append({\"المبلغ\": المبلغ, \"النوع\": النوع, \"التصنيف\": التصنيف})\n",
        "\n",
        "def احسب_الرصيد():\n",
        "    المجموع = 0\n",
        "    for عملية in العمليات:\n",
        "        if عملية[\"النوع\"] == \"دخل\":\n",
        "            المجموع += عملية[\"المبلغ\"]\n",
        "        else:\n",
        "            المجموع -= عملية[\"المبلغ\"]\n",
        "    return المجموع\n",
        "\n",
        "while True:\n",
        "    print(\"\\n1) أضف دخل\")\n",
        "    print(\"2) أضف مصروف\")\n",
        "    print(\"3) اعرض الرصيد\")\n",
        "    print(\"4) خروج\")\n",
        "    الاختيار = input(\"اختر رقم: \")\n",
        "\n",
        "    if الاختيار == \"1\":\n",
        "        المبلغ = float(input(\"المبلغ: \"))\n",
        "        التصنيف = input(\"التصنيف: \")\n",
        "        أضف_عملية(المبلغ, \"دخل\", التصنيف)\n",
        "    elif الاختيار == \"2\":\n",
        "        المبلغ = float(input(\"المبلغ: \"))\n",
        "        التصنيف = input(\"التصنيف: \")\n",
        "        أضف_عملية(المبلغ, \"مصروف\", التصنيف)\n",
        "    elif الاختيار == \"3\":\n",
        "        print(\"الرصيد:\", احسب_الرصيد())\n",
        "    elif الاختيار == \"4\":\n",
        "        break"
      ]
    }
